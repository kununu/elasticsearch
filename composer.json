{
  "name": "kununu/elasticsearch",
  "description": "Library for simplified querying and usage of Elasticsearch/OpenSearch @ Kununu",
  "license": "proprietary",
  "type": "library",
  "authors": [
    {
      "name": "Stefan Csizmazia",
      "email": "stefan.csizmazia@kununu.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "elasticsearch/elasticsearch": "^7.1",
    "kununu/collections": "^7.0 || ^8.0",
    "opensearch-project/opensearch-php": "^2.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "jetbrains/phpstorm-attributes": "^1.2",
    "kununu/code-tools": "^4.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^12.5",
    "shipmonk/composer-dependency-analyser": "^1.8"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Kununu\\Elasticsearch\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kununu\\Elasticsearch\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "kununu/code-tools": true,
      "php-http/discovery": false
    },
    "sort-packages": true
  },
  "scripts": {
    "cs": "composer kununu:cs-fixer src/ tests/",
    "phpstan": "phpstan",
    "rector": "rector process --dry-run --config rector-ci.php src/ tests/",
    "rector-fix": "rector process --config rector-ci.php src/ tests/",
    "sniffer": "phpcs",
    "test": "phpunit --log-events-text phpunit.log --no-coverage --no-logging --testsuite Full",
    "test-coverage": "XDEBUG_MODE=coverage phpunit --log-events-text phpunit.log --testsuite Full"
  },
  "scripts-descriptions": {
    "cs": "Run PHP CS Fixer with kununu code standards",
    "phpstan": "Run PHPStan",
    "rector": "Run Rector in dry-run mode with CI rules",
    "rector-fix": "Run Rector in fix mode with CI rules",
    "sniffer": "Run PHP_CodeSniffer",
    "test": "Run all tests",
    "test-coverage": "Run all tests with coverage report"
  }
}
